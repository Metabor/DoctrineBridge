{
    "name": "metabor/statemachine-doctrine-bridge",
    "description": "Doctrine implementation of the MetaborStd (Statemachine) for PHP 8.2+",
    "license": "MIT",
    "keywords": ["doctrine", "statemachine", "state machine", "status", "process"],
    "authors": [
        {
            "name": "Oliver Tischlinger",
            "email": "oliver.tischlinger@metabor.de"
        }
    ],
    "require": {
        "php": ">=8.2",
        "metabor/statemachine": "~3.0.0",
        "metabor/metabor-std": "~3.0.0",
        "doctrine/orm": "^2.20 || ^3.0",
        "doctrine/collections": "^2.0",
        "symfony/expression-language": "^6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/var-exporter": "^6.4 || ^7.0"
    },
    "suggest": {
        "clue/graph": "For displaying process graph"
    },
    "autoload": {
        "psr-0": {
            "Metabor\\": "src/"
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev",
    "extra": {
        "branch-alias": {
            "dev-master": "3.0.x-dev",
            "dev-3.0.x-dev": "3.0.x-dev"
        }
    }
}
